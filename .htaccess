# ============================================================
#  SoftHome DZ — configuration serveur (LiteSpeed / Apache / CyberPanel)
#  A placer a la racine du site (public_html).
#  Adresse canonique : https://softhomedz.com  (SANS www)
# ============================================================

# 1) Forcer HTTPS + supprimer le www (canonique = https://softhomedz.com)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://softhomedz.com%{REQUEST_URI} [L,R=301]

# 2) En-tetes de securite
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; object-src 'none'; base-uri 'self'"
</IfModule>

# 3) Cache navigateur des fichiers statiques (vitesse)
#    ATTENTION : les fichiers n'ont pas d'empreinte dans leur nom
#    (style.css et non style.a3f9c1.css). Des durees trop longues
#    empecheraient les visiteurs deja venus de recevoir les mises a jour.
#    D'ou des durees bornees, alignees sur le fichier _headers (Netlify).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresDefault "access plus 2 days"
</IfModule>

# 3bis) Le HTML doit toujours refleter le dernier deploiement
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# 4) Compression (gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# 5) Page 404 personnalisee
ErrorDocument 404 /404.html
